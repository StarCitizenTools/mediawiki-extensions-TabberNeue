{
	"private": true,
	"scripts": {
		"lint": "npm -s run lint:js && npm -s run lint:styles && npm -s run lint:i18n",
		"lint:fix:js": "npm -s run lint:js -- --fix",
		"lint:fix:styles": "npm -s run lint:styles -- --fix",
		"lint:i18n": "banana-checker --requireLowerCase=0 i18n/",
		"lint:js": "eslint --cache --max-warnings 0 .",
		"lint:styles": "stylelint \"**/*.{less,css}\"",
		"test": "vitest run",
		"test:watch": "vitest",
		"preflight": "npm -s run lint && npm -s test"
	},
	"devDependencies": {
		"@vitest/coverage-v8": "^5.0.5",
		"@wikimedia/types-wikimedia": "0.8.0",
		"eslint": "9.39.5",
		"eslint-config-wikimedia": "0.33.1",
		"eslint-plugin-no-jquery": "6.0.2",
		"grunt-banana-checker": "0.13.0",
		"jsdom": "^31.0.0",
		"stylelint-config-recess-order": "7.9.0",
		"stylelint-config-wikimedia": "0.20.0",
		"stylelint-order": "8.1.3",
		"vitest": "^5.1.0"
	}
}
